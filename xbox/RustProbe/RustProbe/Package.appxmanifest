<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!-- Publisher muss zum Signaturzertifikat passen (Visual Studio: Package.appxmanifest → Packaging → Choose Certificate). -->
  <Identity Name="GtaBerlin.RustProbe" Publisher="CN=GtaBerlinDev" Version="0.1.0.0" />
  <mp:PhoneIdentity PhoneProductId="3e8b5c2d-9a41-4b6f-8d7e-2c5a1f0b9e63" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>GTA Berlin – Rust-Probe</DisplayName>
    <PublisherDisplayName>Privat</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="de-DE"/>
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="RustProbe.App">
      <uap:VisualElements
        DisplayName="GTA Berlin – Rust-Probe"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Machbarkeitsprobe: Rust und wgpu (DX12) in einem SwapChainPanel"
        BackgroundColor="#14151C">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#14151C" />
      </uap:VisualElements>
    </Application>
  </Applications>
</Package>
