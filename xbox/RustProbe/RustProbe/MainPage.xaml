<Page
    x:Class="RustProbe.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Black">
        <SwapChainPanel x:Name="Panel" />
        <!-- Standardschrift: Consolas fehlt auf der Xbox (·, ×, Umlaute wurden zu Ersatzzeichen); klein, weil das
             Fenster dort 960 × 540 Einheiten hat -->
        <Border Background="#C0000000" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,16,24,16" Padding="10">
            <TextBlock x:Name="Report" FontSize="11" Foreground="White" TextWrapping="Wrap" Text="Probe startet …" />
        </Border>
    </Grid>
</Page>
